{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoServe",
  "version": "1.0.0",
  "identifier": "sa.autoserve.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoServe — Workshop OS",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AutoServe Workshop OS",
    "longDescription": "Automotive workshop operations, repairs, inspections, inventory, and invoicing system.",
    "copyright": "© 2026 AutoServe"
  }
}
