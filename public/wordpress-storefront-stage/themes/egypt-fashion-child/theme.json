{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": { "contentSize": "1280px", "wideSize": "1440px" },
    "color": {
      "palette": [
        { "slug": "base", "color": "#f6f3ed", "name": "عاجي" },
        { "slug": "contrast", "color": "#292923", "name": "حبر" },
        { "slug": "accent", "color": "#d8d1c3", "name": "مدار" },
        { "slug": "muted", "color": "#e8e3d8", "name": "هادئ" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "madar", "name": "مدار", "fontFamily": "Alexandria, sans-serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
    "typography": { "fontFamily": "var:preset|font-family|madar", "lineHeight": "1.9" },
    "elements": {
      "button": { "border": { "radius": "0" }, "color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" } },
      "link": { "color": { "text": "var:preset|color|contrast" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "رأس مدار", "area": "header" },
    { "name": "footer", "title": "تذييل مدار", "area": "footer" }
  ]
}
